+    logical function while_loop_header(parser,start) result(is_while)
+        type(parser_state_t),intent(in)::parser
+        integer,intent(in)::start
+        integer::j
+        is_while=.false.;j=start
+        do while(j<=size(parser%tokens))
+            if(parser%tokens(j)%kind/=TK_WHITESPACE) exit
+            j=j+1
+        end do
+        if(j>size(parser%tokens)) return
+        if(parser%tokens(j)%kind/=TK_KEYWORD) return
+        if(to_lower(trim(parser%tokens(j)%text))/='while') return
+        j=j+1
+        do while(j<=size(parser%tokens))
+            if(parser%tokens(j)%kind/=TK_WHITESPACE) exit
+            j=j+1
+        end do
+        if(j>size(parser%tokens)) return
+        is_while=parser%tokens(j)%kind==TK_OPERATOR.and.parser%tokens(j)%text=='('
+    end function while_loop_header
 
