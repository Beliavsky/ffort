+    function peek_use_token(parser) result(token)
+        type(parser_state_t),intent(inout)::parser
+        type(token_t)::token
+        ! Normalized continuations retain comments but remove continued
+        ! newlines. Never skip a remaining logical statement boundary.
+        do
+            token=parser%peek()
+            if(token%kind/=TK_COMMENT.and.token%kind/=TK_WHITESPACE) return
+            token=parser%consume()
+        end do
+    end function peek_use_token
