+    recursive function handle_cshift_intrinsic(arena, call_node, get_type_fn) result(typ)
+        type(ast_arena_t), intent(inout) :: arena
+        type(call_or_subscript_node), intent(in) :: call_node
+        procedure(get_type_lookup) :: get_type_fn
+        type(mono_type_t) :: typ
+        integer :: i, arg, source
+        typ = create_mono_type(TREAL)
+        source = 0
+        if (.not. allocated(call_node%arg_indices)) return
+        do i = 1, size(call_node%arg_indices)
+            arg = call_node%arg_indices(i)
+            if (.not. arena%has_node_at(arg)) return
+            select type (actual => arena%entries(arg)%node)
+            type is (assignment_node)
+                if (.not. actual%is_keyword_argument) return
+                if (.not. arena%has_node_at(actual%target_index)) return
+                select type (key => arena%entries(actual%target_index)%node)
+                type is (identifier_node)
+                    if (to_lower(key%name) == 'array') source = actual%value_index
+                end select
+            class default
+                if (i == 1) source = arg
+            end select
+        end do
+        if (.not. arena%has_node_at(source)) return
+        typ = get_type_fn(arena, source)
+        call typ%sync_from_arena()
+    end function handle_cshift_intrinsic
