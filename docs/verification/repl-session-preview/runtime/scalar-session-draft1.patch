+    subroutine execute_scalar_session(session,prog,diag,max_steps,commit)
+        type(scalar_session_t),intent(inout)::session
+        type(program_t),intent(in)::prog
+        type(diagnostic_t),intent(inout)::diag
+        integer(int64),intent(in),optional::max_steps
+        logical,intent(in),optional::commit
+        type(pointer_context_t)::context
+        integer(int64),target::rng
+        integer::j,start
+        logical::save_state
+        if(diag%code/=0)return
+        if(session%tainted)then
+            call fail(diag,'scalar session tainted; reset required',0,0);return
+        end if
+        call validate_scalar_session_program(prog,diag)
+        if(diag%code/=0)return
+        save_state=.true.;if(present(commit))save_state=commit
+        if(session%ready)then
+            if(prog%ns/=session%snapshot%ns.or.prog%nc<session%snapshot%nc.or. &
+                prog%ne<session%snapshot%ne.or.prog%name/=session%snapshot%name)then
+                call fail(diag,'scalar session declaration or prefix changed; reset required',0,0);return
+            end if
+            do j=1,prog%ns
+                if(.not.session_same_symbol(prog%symbols(j),session%snapshot%symbols(j)))exit
+            end do
+            if(j<=prog%ns)then
+                call fail(diag,'scalar session declaration changed; reset required',0,0);return
+            end if
+            do j=1,session%snapshot%ne
+                if(.not.session_same_expr(prog%expressions(j),session%snapshot%expressions(j)))exit
+            end do
+            if(j<=session%snapshot%ne)then
+                call fail(diag,'scalar session expression prefix changed; reset required',0,0);return
+            end if
+            do j=1,session%snapshot%nc
+                if(.not.session_same_instruction(prog%code(j),session%snapshot%code(j)))exit
+            end do
+            if(j<=session%snapshot%nc)then
+                call fail(diag,'scalar session instruction prefix changed; reset required',0,0);return
+            end if
+        else if(.not.save_state)then
+            call fail(diag,'scalar query requires an established session',0,0);return
+        end if
+        start=scalar_session_frontier(session)
+        if(.not.save_state)then
+            call validate_scalar_session_query(prog,start-1,diag)
+            if(diag%code/=0)return
+        end if
+        if(present(max_steps))then
+            if(max_steps<=0)then
+                call fail(diag,'scalar session step budget must be positive',0,0);return
+            end if
+        end if
+        rng=session%rng
+        context%generation(0)=1_int64;context%live(0)=.true.
+        call execute_frame(prog,diag,max_steps=max_steps,random_state=rng,context=context, &
+            frame_depth=0,scalar_state=session,scalar_start=start,scalar_commit=save_state)
+        context%live(0)=.false.;nullify(context%frames(0)%refs)
+        if(diag%code/=0)then
+            ! External output cannot be rolled back. Never retry a failed suffix.
+            session%tainted=.true.;return
+        end if
+        if(save_state)then
+            session%snapshot=prog;session%rng=rng;session%ready=.true.
+        end if
+    end subroutine
+    subroutine validate_scalar_session_program(prog,diag)
+        type(program_t),intent(in)::prog
+        type(diagnostic_t),intent(inout)::diag
+        type(symbol_t)::symbol
+        type(expr_t)::expr
+        type(instruction_t)::ins
+        type(value_t)::literal
+        integer::j,k,n
+        if(diag%code/=0)return
+        if(prog%ns<0.or.prog%ns>max_symbols.or.prog%ne<0.or.prog%ne>max_expressions.or. &
+            prog%nc<0.or.prog%nc>max_instructions)goto 900
+        if(prog%np/=0.or.prog%nm/=0.or.prog%nt/=0.or.prog%no/=0.or.prog%ng/=0.or. &
+            prog%nu/=0.or.prog%entry_pc/=1)goto 900
+        if(.not.allocated(prog%symbols).or..not.allocated(prog%expressions).or..not.allocated(prog%code))goto 900
+        if(size(prog%symbols)<prog%ns.or.size(prog%expressions)<prog%ne.or.size(prog%code)<prog%nc)goto 900
+        do j=1,prog%ns
+            associate(v=>prog%symbols(j))
+            symbol=symbol_t();symbol%name=v%name;symbol%typ=v%typ;symbol%real_kind=v%real_kind
+            symbol%line=v%line;symbol%column=v%column;symbol%character_len=v%character_len
+            symbol%length_expr=v%length_expr;symbol%kind_expr=v%kind_expr
+            if(.not.session_same_symbol(v,symbol))goto 900
+            if(len_trim(v%name)==0.or.v%typ<ty_integer.or.v%typ>ty_character)goto 900
+            if(v%real_kind/=4.and.v%real_kind/=8)goto 900
+            if(v%typ==ty_character)then
+                if(v%real_kind/=4.or.v%character_len<0.or.v%character_len>65536)goto 900
+            else if(v%character_len/=-1)then
+                goto 900
+            end if
+            if(v%kind_expr<0.or.v%kind_expr>prog%ne.or.v%length_expr<0.or.v%length_expr>prog%ne)goto 900
+            do k=1,j-1
+                if(prog%symbols(k)%name==v%name)goto 900
+            end do
+            end associate
+        end do
+        do j=1,prog%ne
+            associate(v=>prog%expressions(j))
+            expr=expr_t();expr%kind=v%kind;expr%typ=v%typ;expr%real_kind=v%real_kind
+            expr%line=v%line;expr%column=v%column;expr%character_len=v%character_len
+            expr%parenthesized=v%parenthesized
+            if(v%typ<ty_integer.or.v%typ>ty_character.or.(v%real_kind/=4.and.v%real_kind/=8))goto 900
+            if(v%typ/=ty_character.and.v%character_len/=-1)goto 900
+            if(v%typ==ty_character.and.(v%real_kind/=4.or.v%character_len<0.or.v%character_len>65536))goto 900
+            select case(v%kind)
+            case(ex_literal)
+                literal=value_t(tag=v%typ,real_kind=v%real_kind)
+                select case(v%typ)
+                case(ty_integer)
+                    literal%i=v%value%i
+                    if(v%real_kind==4.and.(literal%i<imin.or.literal%i>imax))goto 900
+                case(ty_real)
+                    literal%r=v%value%r
+                    if(.not.ieee_is_finite(literal%r))goto 900
+                case(ty_logical)
+                    literal%l=v%value%l
+                case(ty_character)
+                    if(.not.allocated(v%value%s))goto 900
+                    if(len(v%value%s)>65536.or.len(v%value%s)/=v%character_len.or.v%real_kind/=4)goto 900
+                    literal%s=v%value%s
+                end select
+                if(.not.session_same_value(v%value,literal))goto 900
+                expr%value=literal
+            case(ex_variable)
+                expr%symbol=v%symbol
+                if(v%symbol<1.or.v%symbol>prog%ns)goto 900
+                if(v%typ/=prog%symbols(v%symbol)%typ.or.v%real_kind/=prog%symbols(v%symbol)%real_kind.or. &
+                    v%character_len/=prog%symbols(v%symbol)%character_len)goto 900
+            case(ex_unary)
+                expr%left=v%left;expr%op=v%op
+                if(v%left<1.or.v%left>=j)goto 900
+                if(v%op/='+'.and.v%op/='-'.and.v%op/='.not.')goto 900
+            case(ex_binary)
+                expr%left=v%left;expr%right=v%right;expr%op=v%op
+                if(v%left<1.or.v%left>=j.or.v%right<1.or.v%right>=j)goto 900
+                select case(trim(v%op))
+                case('+','-','*','/','**','//','==','/=','<','<=','>','>=','.and.','.or.','.eqv.','.neqv.')
+                case default;goto 900
+                end select
+            case default;goto 900
+            end select
+            if(.not.session_same_expr(v,expr))goto 900
+            end associate
+        end do
+        do j=1,prog%nc
+            associate(v=>prog%code(j))
+            ins=instruction_t();ins%op=v%op;ins%line=v%line;ins%column=v%column
+            select case(v%op)
+            case(op_assign)
+                ins%symbol=v%symbol;ins%a=v%a
+                if(v%symbol<1.or.v%symbol>prog%ns.or.v%a<1.or.v%a>prog%ne)goto 900
+            case(op_random_number)
+                ins%symbol=v%symbol;ins%a=v%a
+                if(v%symbol<1.or.v%symbol>prog%ns.or.v%a<1.or.v%a>prog%ne)goto 900
+                if(prog%symbols(v%symbol)%typ/=ty_real)goto 900
+                if(prog%expressions(v%a)%kind/=ex_variable.or.prog%expressions(v%a)%symbol/=v%symbol.or. &
+                    prog%expressions(v%a)%parenthesized)goto 900
+            case(op_random_seed)
+            case(op_print)
+                if(.not.allocated(v%items))goto 900
+                if(size(v%items)>64)goto 900
+                ins%items=v%items
+                do k=1,size(v%items)
+                    n=v%items(k);if(n<1.or.n>prog%ne)goto 900
+                end do
+                if(allocated(v%format))then
+                    if(len(v%format)>65536)goto 900
+                    ins%format=v%format
+                end if
+            case default;goto 900
+            end select
+            if(.not.session_same_instruction(v,ins))goto 900
+            end associate
+        end do
+        return
+900     call fail(diag,'persistent session supports only plain local intrinsic scalars and straight-line assignment, print and random calls',0,0)
