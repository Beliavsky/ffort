+    logical function session_same_value(a,b) result(same)
+        type(value_t),intent(in)::a,b
+        same=.false.
+        if(a%tag/=b%tag.or.a%real_kind/=b%real_kind.or.a%i/=b%i)return
+        if(transfer(a%r,0_int64)/=transfer(b%r,0_int64))return
