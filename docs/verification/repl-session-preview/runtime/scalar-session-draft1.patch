+    logical function session_same_instruction(a,b) result(same)
+        type(instruction_t),intent(in)::a,b
+        same=.false.
+        if(a%construct_name/=b%construct_name)return
+        if(a%op/=b%op)return
+        if(a%line/=b%line)return
